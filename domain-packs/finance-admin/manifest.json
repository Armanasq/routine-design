{
  "id": "finance-admin",
  "version": "0.1.0",
  "status": "draft_research_only",
  "name": "Bills, claims and financial administration",
  "domain": "finance",
  "support_modes": [
    "delegate",
    "collaborate",
    "learn_practice",
    "support_coach",
    "observe"
  ],
  "capabilities": [
    "organize_bills",
    "track_user_confirmed_due_dates",
    "prepare_claim_documents",
    "calculate_with_verified_inputs"
