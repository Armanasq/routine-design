{
  "id": "travel-logistics",
  "version": "0.1.0",
  "status": "draft_research_only",
  "name": "Travel and personal logistics",
  "domain": "travel",
  "support_modes": [
    "delegate",
    "collaborate",
    "learn_practice",
    "support_coach",
    "observe"
  ],
  "capabilities": [
    "compare_current_travel_information",
    "plan_user_stated_constraints",
    "organize_bookings",
    "monitor_authorized_changes"
  ],
  "external_effects_requiring_explicit_grants": [
    "book_transport",
    "cancel_reservation",
    "pay_provider",
    "share_travel_document"
  ],
  "unsupported_capabilities": [
    "guarantee_fare_or_availability",
    "make_purchase_without_user_grant",
    "assume_travel_document_validity"
  ],
  "evidence_requirements": [
    "current_provider_offer",
    "travel_document_authority",
    "booking_confirmation"
  ],
  "success_conditions": [
    {
      "id": "booking_confirmed",
      "kind": "externally_adjudicated",
      "verified_by": "provider booking record and terms",
      "proxy_is_outcome": false
    },
    {
      "id": "trip_prepared",
      "kind": "incremental",
      "verified_by": "user accepted feasible itinerary and required documents",
      "proxy_is_outcome": false
    }
  ],
  "risk_hazards": [
    "financial_loss",
    "stale_price",
    "identity_data_exposure",
    "irreversible_booking"
  ],
  "hard_rules": [
    "Availability/price must be current and cited",
    "User must approve charge or cancellation",
    "Reservation search is not booking"
  ],
  "intervention_options": [
    "budget_tradeoff",
    "confirm_choice",
    "flag_document_requirement",
    "noop"
  ],
  "noop_available": true,
  "permission_ownership": "shared_independent_policy_engine",
  "domain_memory_scope": "travel",
  "pack_provenance": "docs/universal/ and literature-reviews/",
  "certification": "unreviewed_not_executable"
}
