{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AbstractCapabilityNeed",
  "type": "object",
  "required": [
    "id",
    "goal_id",
    "desired_effects",
    "required_observations",
    "risk_class",
    "purpose",
    "is_executable"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "desired_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_class": {
      "enum": [
        "none",
        "low",
        "moderate",
        "high",
        "prohibited"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "is_executable": {
      "const": false
    },
    "data_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_authority": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_output_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reversibility": {
      "enum": [
        "reversible",
        "compensable",
        "irreversible",
        "unknown"
      ]
    },
    "specialist_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "latest_useful_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "unverified_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
