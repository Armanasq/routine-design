{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegisteredCapabilityOperator",
  "type": "object",
  "required": [
    "qualified_name",
    "version",
    "registry_revision",
    "provider",
    "trust_status",
    "input_schema",
    "preconditions",
    "predicted_effects",
    "required_grants",
    "effect_class",
    "risk_class",
    "outcome_verifiers"
  ],
  "properties": {
    "qualified_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "registry_revision": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "trust_status": {
      "enum": [
        "discovered",
        "schema_checked",
        "trusted",
        "degraded",
        "revoked",
        "removed"
      ]
    },
    "input_schema": {
      "type": "object"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "predicted_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deleted_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_grants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effect_class": {
      "enum": [
        "read",
        "prepare",
        "external_effect"
      ]
    },
    "risk_class": {
      "enum": [
        "none",
        "low",
        "moderate",
        "high",
        "prohibited"
      ]
    },
    "outcome_verifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_freshness_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permitted_data_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "idempotency": {
      "enum": [
        "supported",
        "not_supported",
        "unknown",
        "not_applicable"
      ]
    },
    "cost_estimate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
