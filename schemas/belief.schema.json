{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemporalBelief",
  "type": "object",
  "required": [
    "id",
    "subject_id",
    "proposition",
    "origin",
    "valid_from",
    "recorded_at",
    "evidence_ids"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "proposition": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "explicit",
        "confirmed",
        "inferred",
        "observed",
        "policy_mediated"
      ]
    },
    "scope": {
      "type": "object"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "superseded_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
